# Database — Neon: use the *pooled* connection string (host contains "-pooler").
# It already includes sslmode=require, so DATABASE_SSL is not needed with Neon.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true
# Or, instead of DATABASE_URL, the individual parts:
# POSTGRES_USER= / POSTGRES_PASSWORD= / POSTGRES_SERVER= / POSTGRES_PORT=5432 / POSTGRES_DB=

# JWT (keep the old value when migrating so existing sessions stay valid)
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — only needed if a frontend on another domain calls this API (not needed on Vercel, where both share a domain)
# CORS_ORIGINS=https://other-frontend.example.com,http://localhost:3000

# Cloudflare R2 file storage (the /files endpoints return 503 until all four are set)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=nexus-learning-files

# Production: missing SECRET_KEY / database password stops startup instead of using dev defaults
NODE_ENV=production
PORT=8000
